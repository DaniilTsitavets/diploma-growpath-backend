# Copy to .env and fill in locally. Never commit real values.

# LocalStack (student plan token, taken from your LocalStack account)
LOCALSTACK_AUTH_TOKEN=

# AWS SDK pointed at LocalStack. These are dummy values LocalStack accepts, not real credentials.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# plant-care model adapter: mock | openrouter | bedrock. The key and model are needed only for openrouter.
PLANT_CARE_MODEL_PROVIDER=mock
PLANT_CARE_OPENROUTER_API_KEY=
PLANT_CARE_OPENROUTER_MODEL=

# Per-service database passwords. Local-only throwaway values for the docker-compose databases,
# which are published on 127.0.0.1 only. Real deployments must use different values.
COMMERCE_DB_PASSWORD=commerce_dev
ENTITLEMENT_DB_PASSWORD=entitlement_dev
PLANT_CARE_DB_PASSWORD=plant_care_dev
EXPERT_DB_PASSWORD=expert_dev
